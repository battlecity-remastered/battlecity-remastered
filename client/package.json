{
  "name": "battlecity-client",
  "version": "0.0.0",
  "description": "A remake of old battlecity game in js",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "predev": "npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run build:wasm",
    "build": "vite build",
    "preview": "vite preview",
    "deploy-client": "npm run build && ./node_modules/.bin/gh-pages -d dist",
    "test": "node --test --experimental-specifier-resolution=node",
    "build:wasm": "node ./scripts/build-astar-wasm.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@pixi/tilemap": "^5.0.0",
    "eventemitter2": "^6.0.0",
    "pixi.js": "^8.14.3",
    "underscore": "^1.9.2",
    "stats.js": "^0.17.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vite": "^7.1.11"
  }
}